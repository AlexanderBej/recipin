VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Public delivery endpoint only. No ImageKit key is needed in the browser.
VITE_IMAGEKIT_URL_ENDPOINT=

# Server only: set these in Netlify with Functions scope, never VITE_*.
IMAGEKIT_PRIVATE_KEY=
FIREBASE_PROJECT_ID=
# Single-line JSON service account credentials for the same Firebase project.
FIREBASE_SERVICE_ACCOUNT_JSON=
